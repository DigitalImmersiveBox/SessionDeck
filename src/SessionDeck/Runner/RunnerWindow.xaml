<Window x:Class="ClaudeSessions.RunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Games" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#141518" Foreground="#E6E7EA" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- One tab per game; never takes the keyboard from the game -->
    <Style x:Key="GameTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A9ACB4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,4,10,5" Margin="0,0,4,0">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22242A"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#2C2D33"/>
                <Setter Property="Foreground" Value="#E6E7EA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel>
    <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="10,8,10,6"/>

    <Grid>
      <Border x:Name="Stage"/>

      <!-- A session needs you: the game waits until you choose -->
      <Border x:Name="Notice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#F21E1F23" BorderBrush="#FF7A59" BorderThickness="1.5" CornerRadius="8" Padding="18,14,18,14">
        <StackPanel MinWidth="300" MaxWidth="460">
          <TextBlock x:Name="NoticeTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NoticeText" Foreground="#A9ACB4" Margin="0,3,0,12" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Keep playing" Style="{StaticResource DialogButton}" Click="KeepPlaying_Click"/>
            <Button x:Name="OpenButton" Content="Open session" Style="{StaticResource DialogButton}" Background="#C15F3C"
                    Click="OpenSession_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel Margin="12,6,12,8">
      <TextBlock x:Name="Sessions" DockPanel.Dock="Right" FontSize="12" Foreground="#A9ACB4" Margin="12,0,0,0"/>
      <TextBlock x:Name="Keys" FontSize="12" Foreground="#7D808A" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </StackPanel>
</Window>

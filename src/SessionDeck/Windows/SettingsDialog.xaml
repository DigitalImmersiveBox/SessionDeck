<Window x:Class="ClaudeSessions.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1F23" Foreground="#E6E7EA" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#7D808A"/>
    </Style>

    <!-- A two-way choice like °C / °F -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A9ACB4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="14,4,14,5">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#24262B"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#3A3D45"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One mascot to pick: its picture over its name -->
    <Style x:Key="MascotTile" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A9ACB4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="mascot"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="#17181C" BorderBrush="#2C2F36" BorderThickness="1.5" CornerRadius="8"
                    Padding="8,10,8,8" Margin="0,0,8,8">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="#4A4E58"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="#D97757"/>
                <Setter TargetName="Bg" Property="Background" Value="#22201F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,16,20,18">
    <TextBlock Text="WEATHER" Style="{StaticResource Heading}"/>
    <DockPanel Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Change city…" Style="{StaticResource DialogButton}" Click="ChangeCity_Click"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="CityName" FontSize="14" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="CityNote" FontSize="11.5" Foreground="#A9ACB4" Margin="0,1,0,0"/>
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="UseDetectedLink" Margin="0,6,0,0" FontSize="12" HorizontalAlignment="Left">
      <Hyperlink Foreground="#60A5FA" Click="UseDetected_Click">Use my approximate location instead</Hyperlink>
    </TextBlock>

    <DockPanel Margin="0,14,0,0">
      <Border DockPanel.Dock="Right" Background="#141518" CornerRadius="6" Padding="2">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="CelsiusButton" Style="{StaticResource Segment}" GroupName="unit" Content="°C" Checked="Unit_Checked"/>
          <RadioButton x:Name="FahrenheitButton" Style="{StaticResource Segment}" GroupName="unit" Content="°F" Checked="Unit_Checked"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Temperature" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Height="1" Background="#2C2F36" Margin="0,18,0,16"/>

    <TextBlock Text="MASCOT" Style="{StaticResource Heading}"/>
    <TextBlock Text="Lives in the banner and the widget, and in the tray and taskbar icons."
               FontSize="12" Foreground="#A9ACB4" Margin="0,3,0,10" TextWrapping="Wrap"/>
    <UniformGrid x:Name="MascotTiles" Columns="4" Margin="0,0,-8,-8"/>

    <DockPanel Margin="0,14,0,0">
      <Border DockPanel.Dock="Right" Background="#141518" CornerRadius="6" Padding="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TaskbarOnButton" Style="{StaticResource Segment}" GroupName="taskbar" Content="On" Checked="Taskbar_Checked"/>
          <RadioButton x:Name="TaskbarOffButton" Style="{StaticResource Segment}" GroupName="taskbar" Content="Off" Checked="Taskbar_Checked"/>
        </StackPanel>
      </Border>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="Walk on the taskbar"/>
        <TextBlock Text="Main monitor; hides during full-screen apps." FontSize="11.5" Foreground="#A9ACB4"
                   Margin="0,1,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <Border Height="1" Background="#2C2F36" Margin="0,18,0,16"/>

    <TextBlock Text="UPDATES" Style="{StaticResource Heading}"/>
    <DockPanel Margin="0,8,0,0">
      <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Check for updates" Style="{StaticResource DialogButton}"
              VerticalAlignment="Center" Click="Update_Click"/>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="VersionText" FontSize="14"/>
        <TextBlock x:Name="UpdateNote" FontSize="11.5" Foreground="#A9ACB4" Margin="0,1,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="WhatsNewLink" Margin="0,3,0,0" FontSize="12" HorizontalAlignment="Left" Visibility="Collapsed">
          <Hyperlink Foreground="#60A5FA" Click="WhatsNew_Click">See what's new</Hyperlink>
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- Credits on the left (dib logo and a link to our website), Done on the right -->
    <DockPanel Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource DialogButton}" Background="#C15F3C" IsDefault="True" IsCancel="True"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Height="11" Stretch="Uniform" Fill="#8A8D96" VerticalAlignment="Center" Data="{StaticResource DibLogo}"/>
        <TextBlock Margin="8,0,0,1" FontSize="12" Foreground="#7D808A" VerticalAlignment="Center">
          <Run Text="Made by"/>
          <Hyperlink Foreground="#60A5FA" Click="Website_Click" ToolTip="Open digitalimmersivebox.com">Digital Immersive Box</Hyperlink>
        </TextBlock>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>

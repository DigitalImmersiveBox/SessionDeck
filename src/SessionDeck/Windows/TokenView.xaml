<UserControl x:Class="ClaudeSessions.TokenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClaudeSessions"
             Foreground="#E6E7EA" FontFamily="Segoe UI" FontSize="13">
  <!-- Tokens per project or session for the dashboard's time range, drawn one of four ways -->
  <DockPanel Margin="18,14,18,10">
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <RadioButton x:Name="DonutChip" Style="{StaticResource ChipToggle}" GroupName="tokenChart" Content="Donut"
                     Tag="{x:Static local:TokenChartKind.Donut}" Checked="Kind_Checked"/>
        <RadioButton x:Name="BarsChip" Style="{StaticResource ChipToggle}" GroupName="tokenChart" Content="Bars"
                     Tag="{x:Static local:TokenChartKind.Bars}" Checked="Kind_Checked"/>
        <RadioButton x:Name="TreemapChip" Style="{StaticResource ChipToggle}" GroupName="tokenChart" Content="Treemap"
                     Tag="{x:Static local:TokenChartKind.Treemap}" Checked="Kind_Checked"/>
        <RadioButton x:Name="TimelineChip" Style="{StaticResource ChipToggle}" GroupName="tokenChart" Content="Timeline"
                     Tag="{x:Static local:TokenChartKind.Timeline}" Checked="Kind_Checked"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="11" FontWeight="SemiBold" Foreground="#7D808A" TextTrimming="CharacterEllipsis"/>
        <TextBlock Margin="-1,-2,0,0">
          <Run x:Name="TotalText" FontFamily="Segoe UI Light" FontSize="34"/>
          <Run x:Name="TotalUnit" Text="tokens" FontSize="13" Foreground="#A9ACB4"/>
        </TextBlock>
        <TextBlock x:Name="Breakdown" FontSize="11.5" Foreground="#A9ACB4" TextTrimming="CharacterEllipsis"
                   ToolTip="Input: new prompt text · Cache write: context stored for the next turns · Cache read: context re-read on each turn (cheap, but counted) · Output: what Claude wrote"/>
      </StackPanel>
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="-4,12,0,0">
      <RadioButton x:Name="ProjectsChip" Style="{StaticResource ChipToggle}" GroupName="tokenScope" Content="Projects"
                   Checked="Scope_Checked" ToolTip="Tokens per project (all projects)"/>
      <RadioButton x:Name="SessionsChip" Style="{StaticResource ChipToggle}" GroupName="tokenScope" Content="Sessions"
                   Checked="Scope_Checked" ToolTip="Tokens per session (only the project picked on the left, if any)"/>
      <Border Width="1" Background="#2A2D33" Margin="8,3,10,3"/>
      <ToggleButton x:Name="CacheChip" Style="{StaticResource ChipToggle}" Checked="Cache_Changed" Unchecked="Cache_Changed"
                    ToolTip="Count cache reads: the context Claude re-reads on every turn. They are usually over 90 % of all tokens; turn this off to compare the new work only.">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="CacheMark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0"/>
          <TextBlock Text="Cache reads"/>
        </StackPanel>
      </ToggleButton>
    </StackPanel>

    <TextBlock x:Name="Readout" DockPanel.Dock="Bottom" FontSize="11.5" Foreground="#A9ACB4" Margin="0,6,0,0"
               TextTrimming="CharacterEllipsis"/>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition x:Name="LegendColumn" Width="270"/>
      </Grid.ColumnDefinitions>
      <local:TokenChart x:Name="Chart" MinHeight="120"/>
      <ScrollViewer x:Name="LegendScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="18,0,0,0"
                    VerticalAlignment="Center">
        <ItemsControl x:Name="Legend" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:TokenSlice}">
              <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,5,8,5" Cursor="Hand"
                      ToolTip="{Binding Tooltip}" MouseEnter="LegendRow_MouseEnter" MouseLeave="LegendRow_MouseLeave"
                      MouseLeftButtonUp="LegendRow_Click">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}"
                          VerticalAlignment="Top" Margin="0,4,10,0"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="40" TextAlignment="Right"
                             FontSize="11.5" Foreground="#7D808A" Margin="6,1,0,0"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="12" Foreground="#E6E7EA" Margin="8,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#C9CACF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#6E717B" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#1D1F24"/>
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="EmptyText" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" Foreground="#6E717B" Text="Counting tokens…"/>
    </Grid>
  </DockPanel>
</UserControl>

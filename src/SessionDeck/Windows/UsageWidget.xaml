<Window x:Class="ClaudeSessions.UsageWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSessions"
        Title="Claude Usage" Width="372" Height="400"
        WindowStyle="None" Background="#1E1E21"
        ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Foreground="#E6E7EA"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <!-- Plain DWM window (not AllowsTransparency) so the animation renders on the GPU;
       Windows 11 adds the rounded corners, border and shadow (see OnSourceInitialized) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9A9CA3"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B4B6BC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Foreground" Value="#9A9CA3"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#2C2D33"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A header button with a word on it, for the one action that should be easy to find -->
    <Style x:Key="LabelButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C9CACF"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="#2A2B30" BorderBrush="#3A3B42" BorderThickness="1" CornerRadius="5" Padding="8,0,9,1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#3A3B42"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6E7EA"/>
      <Setter Property="Background" Value="#2C2D33"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5,12,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#3A3B42"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8A8D96"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="-8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#2A2B30"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <!-- The card is laid out at a fixed 372 wide and scaled as a whole when the window is resized -->
  <Viewbox Stretch="Uniform" VerticalAlignment="Top">
  <Border x:Name="Card" Width="372" Background="#1E1E21" Padding="20,12,14,12" MouseLeftButtonDown="OnCardMouseDown">
    <StackPanel>
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="CLAUDE USAGE" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center"/>
        <local:PixelHearts x:Name="Hearts" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource LabelButton}" Click="OnDashboard" Margin="0,0,4,0" ToolTip="Open the sessions dashboard">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0.5,0.5 H11.5 V9.5 H0.5 Z M0.5,3.5 H11.5" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,1,6,0"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="MenuButton" Style="{StaticResource HeaderButton}" Click="OnMenu" ToolTip="Menu">
            <Path Data="M0,0 L8,0 L4,5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource HeaderButton}" Click="OnGame" ToolTip="Runner: a little game with your mascot while sessions work">
            <Path Data="M1,0 L9,5 L1,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource HeaderButton}" Click="OnHide" ToolTip="Hide widget (it stays in the tray)">
            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.4"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Big number over Clawd's little world -->
      <Grid Height="80" Margin="0,2,6,0">
        <local:PixelScene x:Name="Scene" Margin="-8,0,-6,0"/>
        <StackPanel x:Name="Hero" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-3,0,0,-2">
          <TextBlock x:Name="Percent" FontFamily="Segoe UI Light" FontSize="62"/>
          <TextBlock Text="%" FontFamily="Segoe UI Light" FontSize="26" Foreground="#C9CACF"
                     VerticalAlignment="Top" Margin="6,8,0,0"/>
        </StackPanel>
      </Grid>

      <Grid Height="8" Margin="0,4,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="BarFill" Width="0*"/>
          <ColumnDefinition x:Name="BarRest" Width="100*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="#3A3B40" CornerRadius="4"/>
        <Border x:Name="BarInk" CornerRadius="4"/>
      </Grid>

      <!-- Reset time, with the small dib logo on the right (visible in compact mode too) -->
      <DockPanel Margin="0,12,6,0">
        <Path DockPanel.Dock="Right" Height="10" Stretch="Uniform" Fill="#6B6E76" VerticalAlignment="Bottom" Margin="12,0,0,5"
              Data="{StaticResource DibLogo}" ToolTip="Made by Digital Immersive Box"/>
        <TextBlock x:Name="ResetText" FontSize="15" Foreground="#D4D5DA" TextWrapping="Wrap"/>
      </DockPanel>

      <!-- Shown only when the login is the problem -->
      <StackPanel x:Name="SignInActions" Orientation="Horizontal" Margin="0,10,6,0" Visibility="Collapsed">
        <Button x:Name="RenewButton" Style="{StaticResource ActionButton}" Background="#C15F3C" Click="OnRenewSignIn"
                ToolTip="Let Claude Code renew its sign-in in the background (uses no plan usage)"/>
        <Button Style="{StaticResource ActionButton}" Content="Sign in…" Click="OnSignIn"
                ToolTip="Open a terminal with `claude auth login` to sign in again in your browser"/>
      </StackPanel>

      <StackPanel x:Name="Details" Margin="0,18,6,0">
        <ItemsControl x:Name="WeekList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:WeekRow}">
              <StackPanel Margin="0,0,0,16">
                <Grid>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                  <TextBlock Text="{Binding Figure}" Style="{StaticResource Figure}"/>
                </Grid>
                <Grid Height="6" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Fill}"/>
                    <ColumnDefinition Width="{Binding Rest}"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.ColumnSpan="2" Background="#3A3B40" CornerRadius="3"/>
                  <Border Background="#C9CACF" CornerRadius="3"/>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
          <TextBlock Text="SESSIONS" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="SessionsText" Style="{StaticResource Figure}"/>
        </Grid>

        <!-- The sessions that matter right now; click one to open it in Claude -->
        <ItemsControl x:Name="SessionList" Focusable="False" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:SessionItem}">
              <Border Style="{StaticResource Row}" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="700"
                      MouseLeftButtonDown="Row_MouseDown" MouseLeftButtonUp="Row_Click">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,8,1" FontSize="13.5" Foreground="#D9DBE0"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding PlanText}" FontSize="12" Foreground="#8A8D96" Margin="0,0,8,0"
                             VerticalAlignment="Center" Visibility="{Binding HasPlan, Converter={StaticResource Vis}}"/>
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="MoreText" Margin="0,4,0,0" FontSize="12" Foreground="#7D808A" Cursor="Hand"
                   MouseLeftButtonDown="Row_MouseDown" MouseLeftButtonUp="More_Click"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B707B" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Margin="10,0,0,1" FontSize="14" Foreground="#D4D5DA" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Margin="0,10,0,0">
          <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="#F5B83D" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
          <TextBlock x:Name="UpdatedText" FontSize="11.5" Foreground="#6B6E76" HorizontalAlignment="Right"/>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
  </Viewbox>
</Window>

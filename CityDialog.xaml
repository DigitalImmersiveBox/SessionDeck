<Window x:Class="ClaudeSessions.CityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather city" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1E1F23" Foreground="#E6E7EA" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="18,16,18,16">
    <TextBlock Text="Which city should the weather be for?" FontWeight="SemiBold"/>
    <DockPanel Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" x:Name="SearchButton" Content="Search" Style="{StaticResource DialogButton}"
              Click="Search_Click" IsDefault="True"/>
      <TextBox x:Name="Query" Padding="6,5" Background="#141518" Foreground="#E6E7EA" BorderBrush="#3A3D45"
               CaretBrush="#E6E7EA" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="Message" Margin="0,10,0,0" Foreground="#A9ACB4" TextWrapping="Wrap"
               Text="Type a city name and press Enter."/>
    <ListBox x:Name="Results" Margin="0,8,0,0" MaxHeight="220" Visibility="Collapsed"
             Background="#141518" Foreground="#E6E7EA" BorderBrush="#3A3D45" DisplayMemberPath="Label"
             SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True"/>
      <Button x:Name="UseButton" Content="Use this city" Style="{StaticResource DialogButton}" Background="#C15F3C"
              IsEnabled="False" Click="Use_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
